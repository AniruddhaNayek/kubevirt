From 3f7799a37eec49f314facd3e1d89990ed157e66e Mon Sep 17 00:00:00 2001
From: Sandeep Gupta <sandeep.gupta12@ibm.com>
Date: Thu, 15 Oct 2026 14:10:21 +0530
Subject: [PATCH] DLM: fix IsMigrationSourceSynchronized always-false on
 ppc64le (Bug 8)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

On ppc64le, getNodeSelectorsFromNodeName() returns an empty map {} because
the node has no host-model-cpu.node.kubevirt.io/ labels.  Two issues
combine to keep IsMigrationSourceSynchronized() returning false forever,
which prevents the target VMIM from ever leaving WaitingForSync:

Issue 1 — nil guard in IsMigrationSourceSynchronized:
  NodeSelectors != nil is checked as part of the readiness signal.
  When the field is omitted from the API server response (see issue 2),
  the in-memory map is nil even though {} was written.  The nil check
  was never meaningful: an empty map correctly means 'no CPU placement
  constraints', which is valid on ppc64le.  Remove the nil gate.

Issue 2 — semantic equality skips the patch:
  patchMigrationStateField uses equality.Semantic.DeepEqual(nil, {}) == true,
  so it never emits a patch operation for nodeSelectors when the map is
  empty.  The field is never written to the API server, stays absent on
  read-back, and the VMI cache always shows nil.
  Fix: guarantee nodeSelectors is never nil before assigning it; an empty
  non-nil map serialises as {} and is written by the add-if-absent path.

Together these fixes unblock the WaitingForSync → Pending transition on
ppc64le single-node same-cluster DLM.
---
 pkg/virt-controller/watch/migration/decentralized.go | 7 +++++++
 staging/src/kubevirt.io/api/core/v1/types.go         | 8 +++++++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/pkg/virt-controller/watch/migration/decentralized.go b/pkg/virt-controller/watch/migration/decentralized.go
index 41615b191c..74bd76e1c2 100644
--- a/pkg/virt-controller/watch/migration/decentralized.go
+++ b/pkg/virt-controller/watch/migration/decentralized.go
@@ -146,6 +146,13 @@ func (c *Controller) updateVMIMigrationSourceWithPodInfo(migration *v1.VirtualMa
 	if err != nil {
 		return err
 	}
+	// getNodeSelectorsFromNodeName returns {} on architectures without
+	// host-model CPU labels (e.g. ppc64le). Ensure the map is never nil
+	// so that JSON serialisation writes the field rather than omitting it;
+	// an absent field looks the same as nil to IsMigrationSourceSynchronized.
+	if nodeSelectors == nil {
+		nodeSelectors = make(map[string]string)
+	}
 	vmiCopy.Status.MigrationState.SourceState.NodeSelectors = nodeSelectors
 
 	if err := c.patchVMI(vmi, vmiCopy); err != nil {
diff --git a/staging/src/kubevirt.io/api/core/v1/types.go b/staging/src/kubevirt.io/api/core/v1/types.go
index 9c17f3be74..030dc64484 100644
--- a/staging/src/kubevirt.io/api/core/v1/types.go
+++ b/staging/src/kubevirt.io/api/core/v1/types.go
@@ -633,11 +633,17 @@ func (v *VirtualMachineInstance) IsMigrationTargetNodeLabelSet() bool {
 
 // Assume that this only called when in decentralized live migration
 func (v *VirtualMachineInstance) IsMigrationSourceSynchronized() bool {
+	// NodeSelectors is intentionally not nil-checked here.
+	// On architectures that have no host-model CPU labels (e.g. ppc64le)
+	// getNodeSelectorsFromNodeName returns an empty map {}, not nil.
+	// Semantic equality treats nil and {} as equal, so the field may be
+	// omitted from the API server response even after it was written.
+	// The meaningful readiness signal is MigrationUID + Pod + Node being set;
+	// an absent NodeSelectors map simply means "no placement constraints".
 	return v.Status.MigrationState != nil && v.Status.MigrationState.SourceState != nil &&
 		v.Status.MigrationState.TargetState != nil &&
 		v.Status.MigrationState.SourceState.MigrationUID != "" &&
 		v.Status.MigrationState.SourceState.Pod != "" &&
-		v.Status.MigrationState.SourceState.NodeSelectors != nil &&
 		v.Status.MigrationState.SourceState.Node != ""
 }
 
