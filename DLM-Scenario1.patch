From 2c2f6184b00ecd43b31c75e07622756c89aff937 Mon Sep 17 00:00:00 2001
From: Sandeep Gupta <sandeep.gupta12@ibm.com>
Date: Thu, 15 Oct 2026 14:37:48 +0530
Subject: [PATCH] DLM: skip node anti-affinity on target pod for same-cluster
 migrations (Bug 9)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

createDecentralizedMigrationPodAntiAffinity() adds a hard NodeAffinity rule:
  kubernetes.io/hostname NotIn [sourceState.Node]

This is correct for cross-cluster DLM where the source node name is
irrelevant in the target cluster's topology, but wrong for same-cluster
DLM (different namespaces, same physical nodes).

In same-cluster DLM the target pod must land on the same node as the
source — the migration moves a VM between namespaces, not between nodes.
The anti-affinity blocks the only available worker node, leaving only the
control-plane node (which has NoSchedule taint), causing FailedScheduling:

  0/2 nodes: 1 didn't match node affinity, 1 had untolerated taint

Fix: skip the anti-affinity when the source node is found in the local
node informer cache (isLocalNode). If the source node is local it is a
same-cluster migration and the target pod can land on any node including
the source node. If the source node is absent from cache it is a
cross-cluster migration and the anti-affinity is still applied.

Validated end-to-end on a 2-node ppc64le cluster (1 control-plane +
1 worker): source VMIM reached Succeeded, target VMI is Running on the
control-plane node after migration from dlm-source to dlm-target namespace.
---
 .../watch/migration/migration.go              | 22 ++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/pkg/virt-controller/watch/migration/migration.go b/pkg/virt-controller/watch/migration/migration.go
index 763a078c22..05be7d8771 100644
--- a/pkg/virt-controller/watch/migration/migration.go
+++ b/pkg/virt-controller/watch/migration/migration.go
@@ -1058,7 +1058,15 @@ func (c *Controller) createTargetPod(migration *virtv1.VirtualMachineInstanceMig
 	}
 
 	if migration.IsDecentralizedTarget() {
-		createDecentralizedMigrationPodAntiAffinity(templatePod, vmi)
+		// For same-cluster DLM the target pod must land on the same node as
+		// the source (the VM is moving between namespaces, not nodes).
+		// Only add the node anti-affinity for cross-cluster DLM where the
+		// source node name is meaningless in the target cluster's topology.
+		// We detect same-cluster by checking whether the source node name
+		// exists in the local node informer cache.
+		if !c.isLocalNode(vmi.Status.MigrationState.SourceState.Node) {
+			createDecentralizedMigrationPodAntiAffinity(templatePod, vmi)
+		}
 		selinuxContext = vmi.Status.MigrationState.SourceState.SelinuxContext
 	} else {
 		createMigrationPodAntiAffinityRule(templatePod, vmi)
@@ -1299,6 +1307,18 @@ func (c *Controller) getNodeSelectorsFromNodeName(nodeName string) (map[string]s
 	return res, nil
 }
 
+// isLocalNode returns true when nodeName is present in this controller's node
+// informer cache — i.e. the node belongs to the same cluster.  Used to
+// distinguish same-cluster DLM (different namespaces, same nodes) from
+// cross-cluster DLM (different physical clusters with different node sets).
+func (c *Controller) isLocalNode(nodeName string) bool {
+	if nodeName == "" {
+		return false
+	}
+	_, exists, err := c.nodeStore.GetByKey(nodeName)
+	return err == nil && exists
+}
+
 // updateTargetPodNetworkInfo generates the network-info annotation from the target pod's network-status
 func (c *Controller) updateTargetPodNetworkInfo(vmi *virtv1.VirtualMachineInstance, pod *k8sv1.Pod) error {
 	newAnnotations := c.netAnnotationsGenerator.GenerateFromActivePod(vmi, pod)
